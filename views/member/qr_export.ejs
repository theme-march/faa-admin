<div class="page-header page-header-light">
    <div class="breadcrumb-line breadcrumb-line-light header-elements-md-inline"><div class="d-flex"><div class="breadcrumb">
        <a href="/dashboard" class="breadcrumb-item"><i class="icon-home2 mr-2"></i> Dashboard</a><a href="/members" class="breadcrumb-item">Member</a><span class="breadcrumb-item active">Member QR Export</span>
    </div></div></div>
</div>

<style>
    .qr-export-shell{max-width:1180px;margin:0 auto}.qr-export-hero{position:relative;overflow:hidden;padding:26px 28px;color:var(--admin-text);background:var(--admin-surface);border:1px solid var(--admin-border);border-top:4px solid var(--admin-primary);border-radius:12px;box-shadow:0 4px 14px rgba(15,23,42,.05)}.qr-export-hero:after{content:"";position:absolute;right:-72px;top:-118px;width:280px;height:280px;background:rgba(37,99,235,.025);border:1px solid rgba(37,99,235,.08);border-radius:50%;box-shadow:0 0 0 48px rgba(37,99,235,.018)}.qr-export-kicker{position:relative;z-index:1;margin:0 0 7px;color:var(--admin-primary);font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase}.qr-export-hero h1{position:relative;z-index:1;margin:0 0 8px;color:var(--admin-text);font-size:26px;font-weight:800;letter-spacing:-.02em}.qr-export-hero p{position:relative;z-index:1;max-width:780px;margin:0;color:var(--admin-muted);font-size:13px;line-height:1.6}.qr-export-stats{position:relative;z-index:1;display:flex;flex-wrap:wrap;gap:10px;margin-top:18px}.qr-export-stat{display:inline-flex;align-items:center;gap:8px;padding:8px 12px;color:#334155;background:#f8fafc;border:1px solid var(--admin-border);border-radius:9px;font-size:11px;font-weight:600}.qr-export-stat i{color:var(--admin-primary)}.qr-export-stat strong{color:var(--admin-text);font-size:13px}.qr-export-card{margin-top:16px;border:1px solid var(--admin-border);border-radius:12px;box-shadow:0 4px 14px rgba(15,23,42,.045)}.qr-export-card .card-body{padding:25px}.qr-export-card h5{margin:0 0 5px;color:var(--admin-text);font-size:18px;font-weight:750}.qr-export-help{margin:0 0 20px;color:var(--admin-muted);font-size:12px}.qr-filter-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}.qr-filter label{display:block;margin-bottom:6px;color:#334155;font-size:11px;font-weight:700}.qr-filter .form-control{height:42px;color:#1e293b;background:#fff;border-color:#cbd5e1;border-radius:8px;font-size:12px}.qr-filter .form-control:focus{border-color:#60a5fa;box-shadow:0 0 0 3px rgba(37,99,235,.12)}.qr-filter small{display:block;margin-top:5px;color:#94a3b8;font-size:10px}.qr-selection-row{display:grid;grid-template-columns:minmax(0,1fr) 220px;gap:14px;align-items:stretch;margin-top:17px}.qr-selection-summary{display:flex;align-items:center;padding:14px 16px;color:#475569;background:#f8fafc;border:1px solid var(--admin-border);border-radius:9px;font-size:11px;line-height:1.55}.qr-count-panel{padding:14px 16px;background:var(--admin-primary-soft);border:1px solid #bfdbfe;border-radius:9px}.qr-count-panel span{display:block;color:#1d4ed8;font-size:9px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.qr-count-panel strong{display:block;margin-top:4px;color:#1e40af;font-size:27px;line-height:1}.qr-count-loading{opacity:.45}.qr-export-actions{display:flex;flex-wrap:wrap;gap:9px;margin-top:19px}.qr-export-actions .btn{min-height:40px;border-radius:8px;font-size:12px;font-weight:650}.qr-export-note{display:flex;align-items:flex-start;gap:10px;margin-top:16px;padding:12px 14px;color:#475569;background:#f8fafc;border:1px solid var(--admin-border);border-radius:8px;font-size:11px;line-height:1.55}.qr-export-note.warning{color:#92400e;background:var(--admin-warning-soft);border-color:#fde68a}.qr-export-note i{margin-top:2px;color:var(--admin-primary);font-size:16px}.qr-export-note.warning i{color:var(--admin-warning)}.qr-export-status{display:none;margin-top:13px;padding:11px 13px;border-radius:8px;font-size:11px;font-weight:600}.qr-export-status.show{display:block}.qr-export-status.working{color:#1d4ed8;background:var(--admin-primary-soft);border:1px solid #bfdbfe}.qr-export-status.success{color:#166534;background:var(--admin-success-soft);border:1px solid #bbf7d0}.qr-export-status.error{color:#991b1b;background:var(--admin-danger-soft);border:1px solid #fecaca}.qr-preview{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px;margin-top:16px}.qr-preview-item{padding:14px;background:#fff;border:1px solid var(--admin-border);border-radius:9px}.qr-preview-item i{display:block;margin-bottom:8px;color:var(--admin-primary);font-size:19px}.qr-preview-item strong{display:block;margin-bottom:3px;color:#1e293b;font-size:12px}.qr-preview-item span{color:var(--admin-muted);font-size:10px;line-height:1.5}@media(max-width:991px){.qr-filter-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:767px){.qr-export-hero{padding:22px 18px}.qr-export-hero h1{font-size:22px}.qr-export-card .card-body{padding:20px 16px}.qr-filter-grid,.qr-selection-row{grid-template-columns:1fr}.qr-export-actions{display:grid}.qr-export-actions .btn{width:100%}.qr-preview{grid-template-columns:1fr}}
</style>

<div class="content"><div class="qr-export-shell">
    <section class="qr-export-hero">
        <p class="qr-export-kicker">Member Management</p><h1>Member QR Excel Export</h1>
        <p>Build a flexible Excel export using member type, approval, account status, payment, session and QR availability. Every downloaded member row contains an embedded permanent QR.</p>
        <div class="qr-export-stats"><span class="qr-export-stat"><i class="icon-users4"></i><strong><%= data.allRecordCount %></strong> total member records</span><span class="qr-export-stat"><i class="icon-user-check"></i><strong><%= data.selectedCount %></strong> approved active members</span></div>
    </section>

    <section class="card qr-export-card"><div class="card-body">
        <h5>Choose members to export</h5><p class="qr-export-help">Combine any filters below. The matching count and downloaded workbook always use the same selection.</p>
        <div class="qr-filter-grid">
            <div class="qr-filter"><label for="qr_member_type">Member Type</label><select id="qr_member_type" class="form-control qr-export-filter"><option value="all">All member types</option><% (data.memberTypes || []).forEach(function(item){ %><option value="<%= item.id %>"><%= item.category_name %></option><% }) %></select></div>
            <div class="qr-filter"><label for="qr_approval_status">Approval Status</label><select id="qr_approval_status" class="form-control qr-export-filter"><option value="all">All approval statuses</option><option value="approved" selected>Approved only</option><option value="not_approved">Not approved only</option></select></div>
            <div class="qr-filter"><label for="qr_member_status">Member Status</label><select id="qr_member_status" class="form-control qr-export-filter"><option value="all">Active + Inactive</option><option value="active" selected>Active only</option><option value="inactive">Inactive only</option></select></div>
            <div class="qr-filter"><label for="qr_payment_status">Payment Status</label><select id="qr_payment_status" class="form-control qr-export-filter"><option value="all">All payment statuses</option><option value="paid">Paid only</option><option value="unpaid">Unpaid only</option><option value="cash_pending">Cash pending only</option></select></div>
            <div class="qr-filter"><label for="qr_session">Session / Batch</label><select id="qr_session" class="form-control qr-export-filter"><option value="all">All sessions / batches</option><% (data.sessions || []).forEach(function(item){ %><option value="<%= item.session %>"><%= item.session %></option><% }) %></select></div>
            <div class="qr-filter"><label for="qr_status">QR Availability</label><select id="qr_status" class="form-control qr-export-filter"><option value="all">All QR statuses</option><option value="existing">Existing QR only</option><option value="missing">Missing QR only</option></select><small>Missing QR tokens are created during export.</small></div>
        </div>

        <div class="qr-selection-row"><div id="qr_selection_summary" class="qr-selection-summary">Approved only · Active only · All member types · Paid + Unpaid</div><div id="qr_count_panel" class="qr-count-panel"><span>Members in selection</span><strong id="qr_member_count"><%= data.selectedCount %></strong></div></div>
        <div class="qr-export-actions"><button type="button" class="btn btn-primary" id="download_filtered_qr"><i class="icon-download4 mr-2"></i>Download Filtered Members</button><button type="button" class="btn btn-outline-primary" id="download_all_qr"><i class="icon-file-excel mr-2"></i>Download All Records</button><button type="button" class="btn btn-light" id="reset_qr_filters"><i class="icon-reset mr-2"></i>Reset Filters</button></div>
        <div id="qr_export_status" class="qr-export-status" role="status" aria-live="polite"></div>
        <div class="qr-export-note"><i class="icon-shield-check"></i><div><strong>Permanent QR protection:</strong> export keeps every existing QR unchanged. A token is created only for a selected member whose QR is missing.</div></div>
        <div class="qr-export-note warning"><i class="icon-warning2"></i><div><strong>Card-production warning:</strong> Not approved, inactive or unpaid members can be exported when explicitly selected. Review the Excel status columns before printing cards.</div></div>
        <div class="qr-preview"><div class="qr-preview-item"><i class="icon-qrcode"></i><strong>Embedded QR column</strong><span>Each selected row contains a scannable QR image and verification link.</span></div><div class="qr-preview-item"><i class="icon-filter3"></i><strong>Flexible filters</strong><span>Combine approval, active status, payment, type, batch and QR availability.</span></div><div class="qr-preview-item"><i class="icon-file-excel"></i><strong>Status-rich workbook</strong><span>Excel includes Approval, Member Status and Payment columns for review.</span></div></div>
    </div></section>
</div></div>

<script>
(function(){
    var filters=Array.prototype.slice.call(document.querySelectorAll('.qr-export-filter'));
    var count=document.getElementById('qr_member_count'),countPanel=document.getElementById('qr_count_panel'),summary=document.getElementById('qr_selection_summary');
    var filteredButton=document.getElementById('download_filtered_qr'),allButton=document.getElementById('download_all_qr'),resetButton=document.getElementById('reset_qr_filters'),statusBox=document.getElementById('qr_export_status');
    var allMemberCount=<%- JSON.stringify(Number(data.allRecordCount || 0)) %>,countRequest=0;

    function formBody(scope){var body=new URLSearchParams();body.set('scope',scope||'filtered');body.set('member_type',document.getElementById('qr_member_type').value);body.set('approval_status',document.getElementById('qr_approval_status').value);body.set('member_status',document.getElementById('qr_member_status').value);body.set('payment_status',document.getElementById('qr_payment_status').value);body.set('session',document.getElementById('qr_session').value);body.set('qr_status',document.getElementById('qr_status').value);return body}
    function selectionText(){return filters.map(function(select){return select.options[select.selectedIndex].text}).join(' · ')}
    async function refreshCount(){var requestId=++countRequest;countPanel.classList.add('qr-count-loading');summary.textContent=selectionText();try{var response=await fetch('/member-qr-export/count',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:formBody('filtered').toString()});var result=await response.json();if(!response.ok||!result.success)throw new Error(result.message||'Count unavailable');if(requestId!==countRequest)return;count.textContent=Number(result.count||0).toLocaleString();filteredButton.disabled=Number(result.count||0)<1}catch(error){if(requestId!==countRequest)return;count.textContent='—';filteredButton.disabled=true}finally{if(requestId===countRequest)countPanel.classList.remove('qr-count-loading');allButton.disabled=allMemberCount<1}}
    function fileNameFromHeader(header,fallback){var match=String(header||'').match(/filename="?([^";]+)"?/i);return match?match[1]:fallback}
    async function downloadExport(scope,button){var original=button.innerHTML;filteredButton.disabled=true;allButton.disabled=true;resetButton.disabled=true;button.innerHTML='<i class="icon-spinner4 spinner mr-2"></i>Preparing Excel…';statusBox.className='qr-export-status show working';statusBox.textContent='Generating QR images and placing them into the Excel rows. Large selections may take a little time.';try{var response=await fetch('/member-qr-export/download',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},body:formBody(scope).toString()});if(!response.ok){var errorBody=await response.json().catch(function(){return{}});throw new Error(errorBody.message||'Unable to download the Excel file.')}var blob=await response.blob(),url=URL.createObjectURL(blob),link=document.createElement('a');link.href=url;link.download=fileNameFromHeader(response.headers.get('content-disposition'),'FAA_Members_With_QR.xlsx');document.body.appendChild(link);link.click();link.remove();setTimeout(function(){URL.revokeObjectURL(url)},1500);statusBox.className='qr-export-status show success';statusBox.textContent='Excel file prepared successfully. Your download has started.'}catch(error){statusBox.className='qr-export-status show error';statusBox.textContent=error.message||'Unable to prepare the Excel file.'}finally{button.innerHTML=original;resetButton.disabled=false;refreshCount()}}
    filters.forEach(function(select){select.addEventListener('change',refreshCount)});
    resetButton.addEventListener('click',function(){document.getElementById('qr_member_type').value='all';document.getElementById('qr_approval_status').value='approved';document.getElementById('qr_member_status').value='active';document.getElementById('qr_payment_status').value='all';document.getElementById('qr_session').value='all';document.getElementById('qr_status').value='all';statusBox.className='qr-export-status';refreshCount()});
    filteredButton.addEventListener('click',function(){downloadExport('filtered',filteredButton)});allButton.addEventListener('click',function(){if(confirm('Download every member record, including not approved, inactive and unpaid members?'))downloadExport('all',allButton)});refreshCount();
})();
</script>
