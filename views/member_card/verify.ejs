<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#792f6c">
  <title>FAA Member Verification</title>
  <style>
    :root{--brand:#792f6c;--brand-dark:#4d1745;--brand-deep:#35102f;--brand-soft:#f6eef4;--ink:#281f26;--muted:#746a72;--line:#eadfe7;--surface:#fff;--success:#18754a;--success-bg:#ecf9f2;--success-line:#c9ebd9;--warning:#8a640d;--warning-bg:#fff8e7;--warning-line:#f2dfaa;--danger:#a32836;--danger-bg:#fff1f2;--shadow:0 14px 38px rgba(69,27,61,.08)}
    *{box-sizing:border-box}body{margin:0;min-height:100vh;font-family:"Segoe UI",system-ui,-apple-system,BlinkMacSystemFont,sans-serif;color:var(--ink);background:radial-gradient(circle at 95% 4%,rgba(121,47,108,.07),transparent 24rem),#f8f5f7}button{font:inherit}.shell{width:min(1040px,calc(100% - 40px));margin:0 auto}
    .topbar{position:sticky;z-index:20;top:0;background:rgba(255,255,255,.95);border-bottom:1px solid rgba(121,47,108,.1);backdrop-filter:blur(14px)}.topbar-inner{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;align-items:center;gap:13px;min-width:0}.brand-logo{width:62px;height:47px;object-fit:contain}.brand-title{display:block;color:var(--brand-dark);font-size:16px;font-weight:800;line-height:1.2}.brand-subtitle{display:block;margin-top:3px;color:#8a7d86;font-size:11px;font-weight:650;letter-spacing:.08em;text-transform:uppercase}.staff-nav{display:flex;align-items:center;gap:11px}.staff-copy{text-align:right}.staff-copy strong{display:block;max-width:190px;overflow:hidden;font-size:13px;text-overflow:ellipsis;white-space:nowrap}.staff-copy span{display:block;margin-top:2px;color:#8b7f87;font-size:11px}.portal-link{min-height:42px;display:inline-flex;align-items:center;gap:7px;padding:9px 13px;color:var(--brand);border:1px solid #ddcfd9;border-radius:10px;font-size:12px;font-weight:800;text-decoration:none;transition:background .18s,border-color .18s}.portal-link:hover{background:var(--brand-soft);border-color:#cdb8c7}.portal-link:focus-visible{outline:3px solid rgba(121,47,108,.2);outline-offset:2px}
    .main{padding:28px 0 56px}.verified-banner{display:flex;align-items:center;gap:10px;margin-bottom:15px;padding:12px 15px;color:var(--success);background:var(--success-bg);border:1px solid var(--success-line);border-radius:13px;font-size:13px;font-weight:800}.verified-icon{width:26px;height:26px;display:grid;place-items:center;flex:0 0 auto;color:#fff;background:var(--success);border-radius:50%}.verified-icon svg{width:15px;height:15px}
    .profile-card{position:relative;overflow:hidden;margin-bottom:22px;padding:clamp(24px,4vw,38px);background:#fff;border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow)}.profile-card:after{content:"";position:absolute;right:-130px;top:-165px;width:330px;height:330px;border:1px solid rgba(121,47,108,.08);border-radius:50%;box-shadow:0 0 0 55px rgba(121,47,108,.025)}.profile-top{position:relative;z-index:1;display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:25px}.photo-wrap{width:112px;height:112px;overflow:hidden;display:grid;place-items:center;color:var(--brand);background:linear-gradient(145deg,#f8f0f6,#ede0ea);border:4px solid #fff;border-radius:50%;box-shadow:0 0 0 2px var(--brand),0 10px 24px rgba(68,22,59,.13)}.photo{width:100%;height:100%;object-fit:cover}.photo-fallback{width:100%;height:100%;display:grid;place-items:center;font-size:31px;font-weight:850;letter-spacing:-.04em}.identity{min-width:0}.identity-kicker{margin:0 0 7px;color:#9a718f;font-size:11px;font-weight:800;letter-spacing:.12em;text-transform:uppercase}.identity h1{margin:0;color:#2d222a;font-size:clamp(27px,4vw,40px);line-height:1.12;letter-spacing:-.035em}.member-number{display:inline-flex;align-items:center;gap:7px;margin-top:11px;color:var(--brand);font-size:14px;font-weight:800}.active-status{display:inline-flex;align-items:center;gap:7px;padding:8px 11px;color:var(--success);background:var(--success-bg);border:1px solid var(--success-line);border-radius:20px;font-size:11px;font-weight:800;white-space:nowrap}.active-status.review{color:var(--warning);background:var(--warning-bg);border-color:var(--warning-line)}.active-status:before{content:"";width:7px;height:7px;background:currentColor;border-radius:50%;box-shadow:0 0 0 4px rgba(24,117,74,.1)}
    .info-grid{position:relative;z-index:1;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:1px;margin-top:28px;overflow:hidden;background:var(--line);border:1px solid var(--line);border-radius:14px}.info-item{min-height:86px;padding:16px;background:#fcfafb}.info-item span{display:flex;align-items:center;gap:6px;margin-bottom:7px;color:#998b95;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}.info-item svg{width:14px;height:14px;color:#a7789b}.info-item strong{display:block;overflow:hidden;color:#3c3038;font-size:14px;line-height:1.4;text-overflow:ellipsis}.info-item.organization{grid-column:auto}
    .section-card{padding:clamp(20px,3vw,30px);background:#fff;border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow)}.section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;margin-bottom:20px}.section-head h2{margin:0;font-size:23px;line-height:1.2;letter-spacing:-.025em}.section-head p{margin:6px 0 0;color:var(--muted);font-size:12px;line-height:1.5}.count{min-width:32px;height:32px;display:inline-flex;align-items:center;justify-content:center;padding:0 10px;color:var(--brand);background:var(--brand-soft);border-radius:20px;font-size:12px;font-weight:800}
    .public-note{display:flex;align-items:flex-start;gap:13px;padding:18px 20px;color:#5e515a;background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:var(--shadow)}.public-note-icon{width:38px;height:38px;display:grid;place-items:center;flex:0 0 auto;color:var(--brand);background:var(--brand-soft);border-radius:11px}.public-note h2{margin:0 0 4px;color:#3b2e37;font-size:15px}.public-note p{margin:0;color:var(--muted);font-size:12px;line-height:1.55}.public-note a{color:var(--brand);font-weight:800}
    .event-list{display:grid;gap:13px}.event{position:relative;display:grid;grid-template-columns:60px minmax(0,1fr) auto;align-items:center;gap:17px;padding:17px;background:#fcfafb;border:1px solid #eee4eb;border-radius:16px;transition:border-color .18s,box-shadow .18s,transform .18s}.event:hover{transform:translateY(-1px);border-color:#dac5d4;box-shadow:0 9px 20px rgba(67,25,58,.055)}.date-tile{width:60px;height:64px;display:grid;place-items:center;align-content:center;color:var(--brand);background:#fff;border:1px solid #e2d2dd;border-radius:13px}.date-tile strong{font-size:22px;line-height:1}.date-tile span{margin-top:4px;font-size:9px;font-weight:850;letter-spacing:.1em;text-transform:uppercase}.event-main{min-width:0}.event-main h3{margin:0 0 8px;color:#33272f;font-size:16px;line-height:1.35}.event-meta{display:flex;flex-wrap:wrap;gap:6px 15px;color:var(--muted);font-size:12px;line-height:1.45}.event-meta span{display:inline-flex;align-items:center;gap:6px}.event-meta svg{width:14px;height:14px;color:#a77a9c}.event-badges{display:flex;align-items:flex-end;flex-direction:column;gap:7px}.badge{display:inline-flex;align-items:center;gap:6px;padding:6px 9px;border-radius:20px;font-size:9px;font-weight:850;letter-spacing:.06em;text-transform:uppercase;white-space:nowrap}.badge.paid,.badge.entered{color:var(--success);background:var(--success-bg);border:1px solid var(--success-line)}.badge.ready{color:var(--brand);background:var(--brand-soft);border:1px solid #e0cedb}.badge.warning-badge{color:var(--warning);background:var(--warning-bg);border:1px solid var(--warning-line)}.entry-time{max-width:180px;color:#80737c;font-size:10px;line-height:1.35;text-align:right}
    .event-action{grid-column:2/4;margin-top:-3px}.btn{min-height:44px;display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:10px 15px;color:#fff;background:linear-gradient(135deg,var(--brand),var(--brand-dark));border:0;border-radius:10px;box-shadow:0 8px 17px rgba(121,47,108,.17);font-size:12px;font-weight:800;text-decoration:none;cursor:pointer;transition:transform .18s,box-shadow .18s}.btn:hover{transform:translateY(-1px);box-shadow:0 11px 21px rgba(121,47,108,.23)}.btn:focus-visible{outline:3px solid rgba(121,47,108,.2);outline-offset:2px}.btn[disabled]{cursor:wait;opacity:.72;transform:none}.btn.loading:before{content:"";width:14px;height:14px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin .75s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.warning{display:flex;align-items:flex-start;gap:8px;margin:0;padding:10px 12px;color:var(--warning);background:var(--warning-bg);border:1px solid var(--warning-line);border-radius:10px;font-size:11px;line-height:1.45}.result{display:none;margin-top:9px;padding:10px 12px;border-radius:9px;font-size:11px;font-weight:650;line-height:1.45}.result.ok{display:block;color:var(--success);background:var(--success-bg);border:1px solid var(--success-line)}.result.bad{display:block;color:var(--danger);background:var(--danger-bg);border:1px solid #f3ccd2}
    .empty{display:grid;place-items:center;padding:42px 18px;text-align:center;background:#fcfafb;border:1px dashed #ddced8;border-radius:15px}.empty-icon{width:58px;height:58px;display:grid;place-items:center;margin-bottom:13px;color:#9b6f91;background:var(--brand-soft);border-radius:50%}.empty-icon svg{width:27px;height:27px}.empty strong{font-size:15px}.empty p{max-width:360px;margin:7px 0 0;color:var(--muted);font-size:12px;line-height:1.55}.invalid-card{max-width:620px;margin:50px auto;padding:38px;text-align:center;background:#fff;border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow)}.invalid-icon{width:70px;height:70px;display:grid;place-items:center;margin:0 auto 18px;color:var(--danger);background:var(--danger-bg);border-radius:50%}.invalid-card h1{margin:0;font-size:25px}.invalid-card p{margin:10px auto 22px;color:var(--muted);font-size:14px;line-height:1.55}
    @media(max-width:760px){.shell{width:min(100% - 28px,1040px)}.topbar-inner{min-height:68px}.brand-logo{width:52px;height:40px}.brand-title{font-size:14px}.brand-subtitle,.staff-copy{display:none}.portal-link{width:42px;height:42px;justify-content:center;padding:0}.portal-link span{display:none}.main{padding-top:18px}.profile-card,.section-card{border-radius:18px}.profile-top{grid-template-columns:auto minmax(0,1fr);gap:20px}.active-status{grid-column:1/3;justify-self:start}.info-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.event{grid-template-columns:54px minmax(0,1fr);gap:14px}.date-tile{width:54px;height:59px}.event-badges{grid-column:2;align-items:flex-start;flex-direction:row;flex-wrap:wrap}.entry-time{text-align:left;max-width:none}.event-action{grid-column:2}.section-head h2{font-size:21px}}
    @media(max-width:480px){.shell{width:calc(100% - 20px)}.brand-logo{width:46px}.brand-title{font-size:13px}.profile-card{padding:22px 17px}.profile-top{display:flex;align-items:flex-start;flex-wrap:wrap;gap:16px}.photo-wrap{width:82px;height:82px}.photo-fallback{font-size:24px}.identity{flex:1}.identity h1{font-size:25px}.identity-kicker{margin-top:2px}.active-status{width:max-content}.info-grid{grid-template-columns:1fr 1fr;margin-top:22px}.info-item{min-height:78px;padding:13px}.info-item strong{font-size:12px}.section-card{padding:20px 15px}.event{grid-template-columns:46px minmax(0,1fr);padding:14px 12px;gap:12px}.date-tile{width:46px;height:52px}.date-tile strong{font-size:18px}.event-main h3{font-size:14px}.event-badges,.event-action{grid-column:1/3}.btn{width:100%}.invalid-card{margin:25px auto;padding:28px 20px}}
    .profile-top{grid-template-areas:"photo identity status"}.photo-wrap{grid-area:photo}.identity{grid-area:identity}.active-status{grid-area:status}.identity h1{word-break:normal;overflow-wrap:normal}
    @media(max-width:900px){.profile-top{grid-template-columns:auto minmax(0,1fr);grid-template-areas:"photo identity" "status status";align-items:center;gap:18px 22px}.active-status{grid-column:auto;justify-self:start}.identity h1{font-size:clamp(27px,5vw,36px)}}
    @media(max-width:760px){.verified-banner{align-items:flex-start;line-height:1.4}}
    @media(max-width:480px){.profile-top{display:grid;grid-template-columns:82px minmax(0,1fr);grid-template-areas:"photo identity" "status status";align-items:start;gap:17px 15px}.identity{min-width:0;flex:none}.identity h1{font-size:24px;line-height:1.13}.identity-kicker{font-size:10px}.member-number{font-size:13px}.active-status{grid-column:auto;width:max-content;max-width:100%;justify-self:start}}
    @media(max-width:360px){.profile-top{grid-template-columns:70px minmax(0,1fr)}.photo-wrap{width:70px;height:70px}.identity h1{font-size:21px}.info-grid{grid-template-columns:1fr}.event{grid-template-columns:1fr}.date-tile{width:52px;height:55px}.event-badges,.event-action{grid-column:1}.event-badges{margin-top:2px}}
  </style>
</head>
<body>
  <%
    var paidEvents = registrations || [];
    var memberActive = member && Number(member.admin_approval) === 1 && Number(member.status) === 1;
    var memberInitials = member ? String(member.name || 'FAA').split(/\s+/).filter(Boolean).slice(0,2).map(function(part){ return part.charAt(0); }).join('').toUpperCase() : 'FAA';
    var returnPath = tokenValue ? '/member/verify/' + tokenValue : '/staff';
    function validDate(value){ var date = value ? new Date(value) : null; return date && !isNaN(date.getTime()) ? date : null; }
    function dateDay(value){ var date=validDate(value); return date ? date.toLocaleDateString('en-GB',{day:'2-digit',timeZone:'Asia/Dhaka'}) : '--'; }
    function dateMonth(value){ var date=validDate(value); return date ? date.toLocaleDateString('en-GB',{month:'short',timeZone:'Asia/Dhaka'}) : 'TBA'; }
    function eventDate(value){ var date=validDate(value); return date ? date.toLocaleDateString('en-GB',{weekday:'short',day:'2-digit',month:'short',year:'numeric',timeZone:'Asia/Dhaka'}) : 'Date to be announced'; }
    function eventTime(value){ var date=validDate(value); return date ? date.toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit',timeZone:'Asia/Dhaka'}) : ''; }
    function entryDate(value){ var date=validDate(value); return date ? date.toLocaleString('en-GB',{day:'2-digit',month:'short',year:'numeric',hour:'numeric',minute:'2-digit',timeZone:'Asia/Dhaka'}) : (value || '-'); }
  %>
  <header class="topbar">
    <div class="shell topbar-inner">
      <div class="brand"><img class="brand-logo" src="/global_assets/images/logo.png" alt="FAA"><div><span class="brand-title">Member Verification</span><span class="brand-subtitle">Finance Alumni Association</span></div></div>
      <nav class="staff-nav" aria-label="Staff navigation">
        <% if (staff) { %><div class="staff-copy"><strong><%= staff.name %></strong><span>Signed-in staff</span></div><a class="portal-link" href="/staff"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m10 17-5-5 5-5M5 12h14"/></svg><span>Staff portal</span></a><% } else { %><a class="portal-link" href="/staff/login?returnTo=<%= encodeURIComponent(returnPath) %>"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/></svg><span>Staff login</span></a><% } %>
      </nav>
    </div>
  </header>

  <main class="shell main">
    <% if (!member) { %>
      <section class="invalid-card"><div class="invalid-icon"><svg width="33" height="33" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8V5a2 2 0 0 1 2-2h3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M8 21H5a2 2 0 0 1-2-2v-3"/><path d="m9 9 6 6M15 9l-6 6"/></svg></div><h1>QR verification failed</h1><p><%= message %></p><a class="btn" href="<%= staff ? '/staff' : '/' %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m10 17-5-5 5-5M5 12h14"/></svg><%= staff ? 'Return to staff portal' : 'Back to FAA website' %></a></section>
    <% } else { %>
      <div class="verified-banner"><span class="verified-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m7 12 3 3 7-7"/></svg></span>Identity matched with an official FAA membership record</div>

      <section class="profile-card">
        <div class="profile-top">
          <div class="photo-wrap"><% if (member.member_image) { %><img class="photo" src="/images/member/<%= member.member_image %>" alt="Photo of <%= member.name %>" onerror="this.style.display='none';this.nextElementSibling.style.display='grid'"><span class="photo-fallback" style="display:none"><%= memberInitials %></span><% } else { %><span class="photo-fallback"><%= memberInitials %></span><% } %></div>
          <div class="identity"><p class="identity-kicker">Verified FAA member</p><h1><%= member.name %></h1><span class="member-number"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 4h16v16H4zM8 9h8M8 13h5"/></svg><%= member.membership_number || 'Membership ID unavailable' %></span></div>
          <span class="active-status <%= memberActive ? '' : 'review' %>"><%= memberActive ? 'Active membership' : 'Membership needs review' %></span>
        </div>
        <div class="info-grid">
          <div class="info-item"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4zM8 9h8M8 13h5"/></svg>Membership ID</span><strong><%= member.membership_number || '-' %></strong></div>
          <div class="info-item"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg>Member type</span><strong><%= member.category_name || 'Member' %></strong></div>
          <div class="info-item"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 5h16v14H4zM8 3v4M16 3v4M4 10h16"/></svg>Session / Batch</span><strong><%= member.session || '-' %></strong></div>
          <div class="info-item organization"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 21h18M5 21V7l7-4 7 4v14M9 10h1M14 10h1M9 14h1M14 14h1"/></svg>Organization</span><strong><%= member.organization_name || 'Not provided' %></strong></div>
          <% if (staff) { %>
            <div class="info-item"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg>Email</span><strong><%= member.email || 'Not provided' %></strong></div>
            <div class="info-item"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.2-1.2a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2Z"/></svg>Phone</span><strong><%= member.phone_number || 'Not provided' %></strong></div>
          <% } %>
        </div>
      </section>

      <% if (staff) { %><section class="section-card">
        <header class="section-head"><div><h2>Registered paid events</h2><p>Paid event registrations linked with this membership.</p></div><span class="count"><%= paidEvents.length %></span></header>
        <% if (!paidEvents.length) { %><div class="empty"><span class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg></span><strong>No paid event registration found</strong><p>When this member completes a paid event registration, it will appear here.</p></div><% } %>
        <% if (paidEvents.length) { %><div class="event-list"><% paidEvents.forEach(function(event){ %>
          <article class="event">
            <div class="date-tile"><strong><%= dateDay(event.event_date) %></strong><span><%= dateMonth(event.event_date) %></span></div>
            <div class="event-main"><h3><%= event.event_title %></h3><div class="event-meta"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><%= eventDate(event.event_date) %><% if (eventTime(event.event_date)) { %> · <%= eventTime(event.event_date) %><% } %></span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><%= event.event_venue || 'Venue to be announced' %></span></div></div>
            <div class="event-badges"><span class="badge paid"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m7 12 3 3 7-7"/></svg>Paid</span><% if (event.enter_date_time) { %><span class="badge entered">Entry completed</span><span class="entry-time"><%= entryDate(event.enter_date_time) %></span><% } else if (staff && event.can_check_in) { %><span class="badge ready">Ready for entry</span><% } else if (staff) { %><span class="badge warning-badge">Not assigned</span><% } %></div>
            <% if (!event.enter_date_time && staff && event.can_check_in) { %><div class="event-action"><button class="btn js-checkin" data-registration="<%= event.registration_id %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 8V5a2 2 0 0 1 2-2h3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M8 21H5a2 2 0 0 1-2-2v-3"/><path d="m8 12 2.5 2.5L16 9"/></svg><span>Confirm event entry</span></button><div class="result" id="result-<%= event.registration_id %>"></div></div><% } else if (!event.enter_date_time && staff) { %><div class="event-action"><p class="warning"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 17h.01"/></svg>This event is not assigned to your staff account.</p></div><% } else if (!event.enter_date_time) { %><div class="event-action"><a class="btn" href="/staff/login?returnTo=<%= encodeURIComponent(returnPath) %>"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 17l5-5-5-5M15 12H3M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/></svg>Staff login to take entry</a></div><% } %>
          </article>
        <% }) %></div><% } %>
      </section><% } else { %>
        <section class="public-note" aria-label="Privacy notice">
          <span class="public-note-icon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg></span>
          <div><h2>Basic membership verification</h2><p>Event registrations, payment details and entry records are private. <a href="/staff/login?returnTo=<%= encodeURIComponent(returnPath) %>">Authorized staff can sign in</a> to view operational information.</p></div>
        </section>
      <% } %>
    <% } %>
  </main>
  <% if (staff) { %><script>
    document.querySelectorAll('.js-checkin').forEach(function(button){
      button.addEventListener('click',async function(){
        if(!confirm('Confirm this member\'s event entry?'))return;
        var label=button.querySelector('span');
        var originalLabel=label?label.textContent:'Confirm event entry';
        button.disabled=true;
        button.classList.add('loading');
        if(label)label.textContent='Confirming entry…';
        var id=button.dataset.registration;
        var result=document.getElementById('result-'+id);
        try{
          var response=await fetch('/staff/member-card/checkin',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:<%- JSON.stringify(tokenValue) %>,registration_id:id})});
          var body=await response.json();
          result.textContent=body.message;
          result.className='result '+(body.success?'ok':'bad');
          if(body.success){if(label)label.textContent='Entry confirmed';setTimeout(function(){location.reload()},1200)}
          else{button.disabled=false;button.classList.remove('loading');if(label)label.textContent=originalLabel}
        }catch(e){
          result.textContent='Unable to record entry. Please try again.';
          result.className='result bad';
          button.disabled=false;
          button.classList.remove('loading');
          if(label)label.textContent=originalLabel;
        }
      })
    });
  </script><% } %>
</body>
</html>
