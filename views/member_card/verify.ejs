<!doctype html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FAA Member Verification</title><style>
*{box-sizing:border-box}body{margin:0;background:#f4f1f7;font-family:Arial,sans-serif;color:#25172e}.header{background:linear-gradient(135deg,#351052,#85239e);color:#fff;padding:22px}.headerin,.wrap{max-width:720px;margin:auto}.headerin{display:flex;justify-content:space-between;gap:15px;align-items:center}.staff{font-size:13px;text-align:right}.staff a{color:#fff}.wrap{padding:18px}.card{background:#fff;border-radius:16px;padding:20px;margin-bottom:16px;box-shadow:0 4px 18px #32104812}.verified{color:#187a43;font-weight:800}.profile{display:flex;gap:16px;align-items:center}.photo{width:84px;height:84px;border-radius:50%;object-fit:cover;background:#eee;border:3px solid #7c2990}.meta h1{font-size:23px;margin:0 0 7px}.meta p{margin:4px 0;color:#555}.status{display:inline-block;padding:5px 10px;border-radius:20px;background:#e7f7ed;color:#18713e;font-weight:700;font-size:12px}.event{border:1px solid #e6dce9;border-radius:12px;padding:15px;margin-top:12px}.event h3{margin:0 0 8px}.event p{margin:5px 0;color:#555}.btn{display:inline-block;border:0;border-radius:9px;padding:11px 15px;background:#6b1b85;color:#fff;font-weight:700;text-decoration:none;cursor:pointer;margin-top:8px}.btn[disabled]{background:#aaa;cursor:not-allowed}.entered{color:#18713e;font-weight:700}.warning{background:#fff3cd;color:#715600;padding:12px;border-radius:9px}.error{background:#fee2e2;color:#991b1b;padding:13px;border-radius:9px}.result{display:none;margin-top:10px;padding:10px;border-radius:8px}.result.ok{display:block;background:#e7f7ed;color:#17653a}.result.bad{display:block;background:#fee2e2;color:#991b1b}
</style></head><body><header class="header"><div class="headerin"><strong>FAA Member Verification</strong><div class="staff"><% if (staff) { %>Signed in: <%= staff.name %><br><a href="/staff">Staff portal</a><% } else { %><a href="/staff/login?returnTo=<%= encodeURIComponent('/member/verify/' + tokenValue) %>">Staff login</a><% } %></div></div></header><main class="wrap">
<% if (!member) { %><div class="card"><div class="error"><%= message %></div></div><% } else { %>
<div class="card"><div class="verified">✓ Verified FAA Member</div><div class="profile" style="margin-top:14px"><% if (member.member_image) { %><img class="photo" src="/images/member/<%= member.member_image %>" alt="Member photo"><% } else { %><div class="photo"></div><% } %><div class="meta"><h1><%= member.name %></h1><p><strong><%= member.membership_number %></strong> · <%= member.category_name || 'Member' %></p><p>Session: <%= member.session || '-' %></p><span class="status"><%= Number(member.admin_approval) === 1 && Number(member.status) === 1 ? 'Active membership' : 'Membership needs review' %></span></div></div></div>
<div class="card"><h2>Registered paid events</h2><% if (!(registrations||[]).length) { %><p>No paid event registration was found for this member.</p><% } %>
<% (registrations||[]).forEach(function(event){ %><div class="event"><h3><%= event.event_title %></h3><p><%= event.event_date || '-' %> · <%= event.event_venue || '-' %></p><p>Payment: <strong>Paid</strong></p><% if (event.enter_date_time) { %><p class="entered">Already entered: <%= event.enter_date_time %></p><% } else if (staff && event.can_check_in) { %><button class="btn js-checkin" data-registration="<%= event.registration_id %>">Confirm Entry</button><div class="result" id="result-<%= event.registration_id %>"></div><% } else if (staff) { %><p class="warning">This event is not assigned to your staff account.</p><% } else { %><a class="btn" href="/staff/login?returnTo=<%= encodeURIComponent('/member/verify/' + tokenValue) %>">Staff Login to Take Entry</a><% } %></div><% }) %></div>
<% } %></main><script>document.querySelectorAll('.js-checkin').forEach(function(button){button.addEventListener('click',async function(){if(!confirm('Confirm this event entry?'))return;button.disabled=true;var id=button.dataset.registration;var result=document.getElementById('result-'+id);try{var response=await fetch('/staff/member-card/checkin',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({token:<%- JSON.stringify(tokenValue) %>,registration_id:id})});var body=await response.json();result.textContent=body.message;result.className='result '+(body.success?'ok':'bad');if(body.success)setTimeout(function(){location.reload()},900);}catch(e){result.textContent='Unable to record entry. Please try again.';result.className='result bad';button.disabled=false;}})});</script></body></html>
