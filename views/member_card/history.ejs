<style>
  .qr-history-page{--qr-brand:#792f6c;--qr-soft:#f7eef5;--qr-line:#eadce6;--qr-success:#18754a;--qr-success-bg:#eaf8f1;--qr-warning:#8a640d;--qr-warning-bg:#fff8e5;--qr-danger:#a32836;--qr-danger-bg:#fff0f2}.qr-history-page .summary-card,.qr-history-page .section-card{border:1px solid var(--qr-line);border-radius:16px;box-shadow:0 8px 24px rgba(67,26,58,.06)}.qr-history-page .summary-card{overflow:hidden;background:linear-gradient(135deg,#fff,#fbf6fa)}.qr-history-page .summary-body{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:24px}.qr-history-page .member-id{display:flex;align-items:center;gap:15px}.qr-history-page .member-avatar{width:60px;height:60px;display:grid;place-items:center;overflow:hidden;flex:0 0 auto;color:var(--qr-brand);background:var(--qr-soft);border:2px solid #d9bfd2;border-radius:50%;font-size:18px;font-weight:800}.qr-history-page .member-avatar img{width:100%;height:100%;object-fit:cover}.qr-history-page .member-id h4{margin:0 0 4px;font-weight:700}.qr-history-page .member-id p{margin:0;color:#796d75}.qr-history-page .summary-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px}.qr-history-page .section-card{margin-top:18px;background:#fff}.qr-history-page .section-head{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;padding:20px 22px;border-bottom:1px solid #eee5eb}.qr-history-page .section-head h5{margin:0}.qr-history-page .section-head p{margin:5px 0 0;color:#7c7078;font-size:12px}.qr-history-page .section-body{padding:20px 22px}.qr-history-page .pending-box{display:grid;grid-template-columns:1fr auto;align-items:center;gap:18px;padding:16px;color:#684b08;background:var(--qr-warning-bg);border:1px solid #eedb9f;border-radius:12px}.qr-history-page .pending-box strong{display:block;margin-bottom:4px}.qr-history-page .pending-box p{margin:0;font-size:12px;line-height:1.5}.qr-history-page .pending-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:7px}.qr-history-page .status-pill{display:inline-flex;align-items:center;gap:6px;padding:5px 9px;border-radius:20px;font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase}.qr-history-page .status-pill:before{content:"";width:7px;height:7px;background:currentColor;border-radius:50%}.qr-history-page .status-active{color:var(--qr-success);background:var(--qr-success-bg)}.qr-history-page .status-pending{color:var(--qr-warning);background:var(--qr-warning-bg)}.qr-history-page .status-revoked{color:#7f737b;background:#f3f0f2}.qr-history-page .status-cancelled{color:var(--qr-danger);background:var(--qr-danger-bg)}.qr-history-page .token-code{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;color:#5d4057;font-size:11px}.qr-history-page .table td,.qr-history-page .table th{vertical-align:middle}.qr-history-page .table th{color:#746872;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.04em}.qr-history-page .token-actions{display:flex;flex-wrap:wrap;gap:6px}.qr-history-page form{margin:0}.qr-history-page .empty-state{padding:35px;text-align:center;color:#81757d;background:#fbf8fa;border:1px dashed #dbcbd6;border-radius:12px}.qr-history-page .danger-zone{display:grid;grid-template-columns:1fr auto;align-items:center;gap:18px;padding:17px;background:var(--qr-danger-bg);border:1px solid #f0cbd1;border-radius:12px}.qr-history-page .danger-zone strong{display:block;color:var(--qr-danger);margin-bottom:5px}.qr-history-page .danger-zone p{max-width:680px;margin:0;color:#80545b;font-size:12px;line-height:1.5}.qr-history-page .audit-list{display:grid;gap:0}.qr-history-page .audit-item{position:relative;display:grid;grid-template-columns:16px minmax(0,1fr) auto;gap:12px;padding:12px 0;border-bottom:1px solid #f0e8ed}.qr-history-page .audit-item:last-child{border-bottom:0}.qr-history-page .audit-dot{width:10px;height:10px;margin-top:5px;background:#b784aa;border:3px solid #f5e9f2;border-radius:50%;box-sizing:content-box}.qr-history-page .audit-item strong{display:block;font-size:12px}.qr-history-page .audit-item p{margin:3px 0 0;color:#7c7078;font-size:11px;line-height:1.45}.qr-history-page .audit-time{color:#93878f;font-size:10px;white-space:nowrap}.qr-history-page .btn-qr{color:#fff;background:var(--qr-brand);border-color:var(--qr-brand)}.qr-history-page .btn-qr:hover{color:#fff;background:#5d2053;border-color:#5d2053}.qr-history-page .btn-outline-qr{color:var(--qr-brand);background:#fff;border-color:#d5bdcf}.qr-history-page .btn-outline-qr:hover{color:#fff;background:var(--qr-brand);border-color:var(--qr-brand)}@media(max-width:767px){.qr-history-page .summary-body,.qr-history-page .pending-box,.qr-history-page .danger-zone{display:block}.qr-history-page .summary-actions,.qr-history-page .pending-actions{justify-content:flex-start;margin-top:15px}.qr-history-page .section-head{padding:17px}.qr-history-page .section-body{padding:15px}.qr-history-page .table-responsive{border:0}.qr-history-page .audit-item{grid-template-columns:16px minmax(0,1fr)}.qr-history-page .audit-time{grid-column:2}.qr-history-page .danger-zone form{margin-top:14px}}
</style>
<%
  var tokenRows = tokens || [];
  var auditRows = audits || [];
  var pendingTokens = tokenRows.filter(function(token){ return Number(token.is_active) === 0 && !token.revoked_at; });
  var activeTokens = tokenRows.filter(function(token){ return Number(token.is_active) === 1; });
  var initials = String(member.name || 'FAA').split(/\s+/).filter(Boolean).slice(0,2).map(function(part){ return part.charAt(0); }).join('').toUpperCase();
  function formatDate(value){ if(!value)return '-';var date=new Date(value);return isNaN(date.getTime())?String(value):date.toLocaleString('en-GB',{day:'2-digit',month:'short',year:'numeric',hour:'numeric',minute:'2-digit',timeZone:'Asia/Dhaka'}); }
  function tokenState(token){ if(Number(token.is_active)===1)return 'active';if(!token.revoked_at)return 'pending';if(token.revoked_reason==='replacement_cancelled')return 'cancelled';return 'revoked'; }
  function actionLabel(action){ return String(action||'').split('_').map(function(word){return word.charAt(0).toUpperCase()+word.slice(1)}).join(' '); }
%>
<div class="page-header page-header-light">
  <div class="breadcrumb-line breadcrumb-line-light"><div class="breadcrumb"><a href="/members" class="breadcrumb-item"><i class="icon-users mr-2"></i>Members</a><span class="breadcrumb-item active">Card QR History</span></div></div>
</div>
<div class="content qr-history-page">
  <section class="summary-card">
    <div class="summary-body">
      <div class="member-id"><div class="member-avatar"><% if(member.member_image){ %><img src="/images/member/<%= member.member_image %>" alt=""><% } else { %><%= initials %><% } %></div><div><h4><%= member.name %></h4><p><strong><%= member.membership_number || '-' %></strong> · Card QR lifecycle</p></div></div>
      <div class="summary-actions"><a href="/member/<%= member.id %>/card-qr" class="btn btn-qr"><i class="icon-download4 mr-2"></i>Download Current QR</a><form action="/member/<%= member.id %>/card-qr/replacement/prepare" method="post" onsubmit="return confirm('Prepare a replacement QR? The current physical-card QR will remain active until you explicitly activate the replacement.');"><button class="btn btn-outline-qr" type="submit"><i class="icon-plus-circle2 mr-2"></i>Prepare Replacement</button></form></div>
    </div>
  </section>

  <% if (pendingTokens.length) { %><section class="section-card"><div class="section-head"><div><h5>Pending replacement</h5><p>Download and print the replacement card first. Activate it only when the new physical card is ready.</p></div><span class="status-pill status-pending">Pending</span></div><div class="section-body"><% pendingTokens.forEach(function(token){ %><div class="pending-box"><div><strong>Replacement QR #<%= token.id %> is not active yet</strong><p>The member's current physical card continues to work. Activating this replacement will immediately stop the current QR.</p></div><div class="pending-actions"><a class="btn btn-sm btn-outline-qr" href="/member/<%= member.id %>/card-qr/<%= token.id %>/download"><i class="icon-download4 mr-1"></i>Download</a><form action="/member/<%= member.id %>/card-qr/replacement/<%= token.id %>/activate" method="post" onsubmit="return confirm('Is the new physical card printed and ready? Activating it will immediately stop the current physical-card QR.');"><button class="btn btn-sm btn-success" type="submit"><i class="icon-checkmark4 mr-1"></i>Activate New QR</button></form><form action="/member/<%= member.id %>/card-qr/replacement/<%= token.id %>/cancel" method="post" onsubmit="return confirm('Cancel this pending replacement? The current physical-card QR will remain active.');"><button class="btn btn-sm btn-light" type="submit">Cancel</button></form></div></div><% }) %></div></section><% } %>

  <section class="section-card">
    <div class="section-head"><div><h5>QR token history</h5><p>Only one token can be active. Full token values are never displayed on this page.</p></div><span class="badge badge-light"><%= tokenRows.length %> token<%= tokenRows.length===1?'':'s' %></span></div>
    <div class="section-body">
      <% if(!tokenRows.length){ %><div class="empty-state">No card QR token has been generated for this member.</div><% } else { %><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Token</th><th>Issued</th><th>Last scanned</th><th>Status</th><th class="text-right">Actions</th></tr></thead><tbody><% tokenRows.forEach(function(token){var state=tokenState(token);%><tr><td><strong>#<%= token.id %></strong><br><span class="token-code"><%= String(token.token_hash||'').slice(0,12) %>…</span></td><td><%= formatDate(token.issued_at) %></td><td><%= formatDate(token.last_scanned_at) %></td><td><span class="status-pill status-<%= state %>"><%= state %></span><% if(token.revoked_reason){ %><br><small class="text-muted"><%= actionLabel(token.revoked_reason) %></small><% } %></td><td><div class="token-actions justify-content-end"><% if(state==='active'){ %><a class="btn btn-sm btn-outline-qr" href="/member/<%= member.id %>/card-qr/<%= token.id %>/download">Download</a><% } else if(state==='pending'){ %><a class="btn btn-sm btn-outline-qr" href="/member/<%= member.id %>/card-qr/<%= token.id %>/download">Download</a><% } else if(state==='revoked'){ %><form action="/member/<%= member.id %>/card-qr/<%= token.id %>/restore" method="post" data-membership="<%= member.membership_number || '' %>" onsubmit="return confirmMembership(this,'Restore this previous physical-card QR? The currently active QR will stop working.');"><input type="hidden" name="confirmation"><button class="btn btn-sm btn-outline-warning" type="submit"><i class="icon-undo2 mr-1"></i>Restore Previous QR</button></form><% } else { %><span class="text-muted small">No action</span><% } %></div></td></tr><% }) %></tbody></table></div><% } %>
    </div>
  </section>

  <section class="section-card">
    <div class="section-head"><div><h5>Security activity</h5><p>Administrative QR lifecycle actions are recorded here.</p></div></div>
    <div class="section-body"><% if(!auditRows.length){ %><div class="empty-state">No replacement or restore activity recorded yet.</div><% } else { %><div class="audit-list"><% auditRows.forEach(function(audit){ %><div class="audit-item"><span class="audit-dot"></span><div><strong><%= actionLabel(audit.action) %></strong><p><%= audit.note || '-' %> · By <%= audit.actor_name || ('Admin #' + (audit.actor_id || '-')) %></p></div><time class="audit-time"><%= formatDate(audit.created_at) %></time></div><% }) %></div><% } %></div>
  </section>

  <section class="section-card">
    <div class="section-head"><div><h5>Lost or stolen card</h5><p>Use immediate replacement only when the existing physical card must stop working now.</p></div></div>
    <div class="section-body"><div class="danger-zone"><div><strong>Immediately revoke every previous QR</strong><p>This action creates a new active QR immediately and invalidates the member's current physical card. It should not be used for a normal card reprint.</p></div><form action="/member/<%= member.id %>/card-qr/reissue" method="post" data-membership="<%= member.membership_number || '' %>" onsubmit="return confirmMembership(this,'Immediate replacement will stop every previous physical-card QR.');"><input type="hidden" name="confirmation"><button class="btn btn-danger" type="submit"><i class="icon-alert mr-2"></i>Replace Lost/Stolen Card</button></form></div></div>
  </section>
</div>
<script>
  function confirmMembership(form,message){
    if(!confirm(message))return false;
    var membershipNumber=String(form.dataset.membership||'');
    var entered=prompt('For safety, enter membership number '+membershipNumber+' to continue:');
    if(entered===null)return false;
    form.querySelector('input[name="confirmation"]').value=String(entered).trim();
    return true;
  }
</script>
