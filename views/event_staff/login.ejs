<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#792f6c">
  <title>FAA Staff Login</title>
  <style>
    :root{--brand:#792f6c;--brand-dark:#4d1745;--brand-deep:#35102f;--brand-soft:#f5edf3;--ink:#241b22;--muted:#70666e;--line:#e8dfe5;--danger-bg:#fff1f2;--danger:#9f2435;--shadow:0 24px 70px rgba(63,21,55,.16)}
    *{box-sizing:border-box}body{margin:0;min-height:100vh;font-family:"Segoe UI",system-ui,-apple-system,BlinkMacSystemFont,sans-serif;color:var(--ink);background:radial-gradient(circle at 9% 8%,rgba(121,47,108,.11),transparent 30rem),radial-gradient(circle at 91% 92%,rgba(121,47,108,.08),transparent 26rem),#faf7fa}button,input{font:inherit}.page{min-height:100vh;display:grid;grid-template-columns:minmax(320px,.92fr) minmax(480px,1.08fr)}
    .brand-panel{position:relative;isolation:isolate;overflow:hidden;display:flex;flex-direction:column;justify-content:space-between;min-height:100vh;padding:clamp(36px,5vw,72px);color:#fff;background:linear-gradient(145deg,var(--brand-deep) 0%,var(--brand-dark) 45%,var(--brand) 100%)}.brand-panel:before,.brand-panel:after{content:"";position:absolute;z-index:-1;border:1px solid rgba(255,255,255,.12);border-radius:50%}.brand-panel:before{width:430px;height:430px;right:-220px;top:-150px}.brand-panel:after{width:560px;height:560px;left:-310px;bottom:-350px}
    .brand-lockup{display:flex;align-items:center;gap:16px}.logo-box{width:78px;height:62px;display:grid;place-items:center;flex:0 0 auto;padding:10px;border-radius:14px;background:#fff;box-shadow:0 10px 25px rgba(25,5,21,.2)}.logo-box img{width:100%;height:100%;object-fit:contain}.brand-name{font-size:17px;font-weight:750;line-height:1.25;letter-spacing:.01em}.brand-name small{display:block;margin-top:4px;color:rgba(255,255,255,.7);font-size:12px;font-weight:500;letter-spacing:.09em;text-transform:uppercase}
    .brand-copy{max-width:520px;margin:80px 0}.eyebrow{margin:0 0 14px;color:#a75996;font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase}.brand-copy .eyebrow{color:rgba(255,255,255,.64)}.brand-copy h1{margin:0;font-size:clamp(36px,4.4vw,66px);line-height:1.03;letter-spacing:-.035em}.brand-copy p{max-width:450px;margin:22px 0 0;color:rgba(255,255,255,.76);font-size:17px;line-height:1.65}.brand-foot{display:flex;align-items:center;gap:10px;color:rgba(255,255,255,.68);font-size:13px}.status-dot{width:8px;height:8px;border-radius:50%;background:#78dc9a;box-shadow:0 0 0 5px rgba(120,220,154,.12)}
    .login-panel{display:grid;place-items:center;padding:42px clamp(24px,7vw,108px)}.login-wrap{width:100%;max-width:500px}.mobile-brand{display:none}.login-wrap h2{margin:0;font-size:clamp(32px,4vw,44px);line-height:1.12;letter-spacing:-.035em}.sub{margin:13px 0 32px;color:var(--muted);font-size:16px;line-height:1.55}.alert{display:flex;align-items:flex-start;gap:10px;margin:0 0 22px;padding:13px 14px;color:var(--danger);background:var(--danger-bg);border:1px solid #ffd8dd;border-radius:12px;font-size:14px;line-height:1.45}
    .field{margin-bottom:20px}label{display:block;margin-bottom:8px;font-size:14px;font-weight:700}.input-wrap{position:relative}.input-icon{position:absolute;left:16px;top:50%;width:20px;height:20px;color:#92868f;transform:translateY(-50%);pointer-events:none}input{width:100%;min-height:54px;padding:13px 48px;color:var(--ink);background:#fff;border:1px solid #d9cfd6;border-radius:12px;outline:none;font-size:16px;transition:border-color .2s,box-shadow .2s}input::placeholder{color:#aaa0a7}input:focus{border-color:var(--brand);box-shadow:0 0 0 4px rgba(121,47,108,.11)}.password-toggle{position:absolute;top:50%;right:8px;width:40px;height:40px;display:grid;place-items:center;padding:0;color:#776b74;background:transparent;border:0;border-radius:9px;cursor:pointer;transform:translateY(-50%)}.password-toggle:hover{color:var(--brand);background:var(--brand-soft)}.password-toggle:focus-visible{outline:3px solid rgba(121,47,108,.22)}
    .submit-btn{width:100%;min-height:56px;display:flex;align-items:center;justify-content:center;gap:10px;margin-top:8px;padding:14px 20px;color:#fff;background:linear-gradient(135deg,var(--brand) 0%,#5d2053 100%);border:0;border-radius:12px;box-shadow:0 12px 24px rgba(121,47,108,.22);font-size:16px;font-weight:750;cursor:pointer;transition:transform .18s,box-shadow .18s}.submit-btn:hover{transform:translateY(-1px);box-shadow:0 15px 30px rgba(121,47,108,.28)}.submit-btn:active{transform:translateY(0)}.submit-btn:focus-visible{outline:3px solid rgba(121,47,108,.25);outline-offset:3px}.security-note{display:flex;justify-content:center;align-items:center;gap:7px;margin:22px 0 0;color:#8a7f87;font-size:12px}.security-note svg{width:15px;height:15px}
    @media(max-width:880px){.page{display:block}.brand-panel{display:none}.login-panel{min-height:100vh;padding:28px 20px}.login-wrap{max-width:460px;padding:28px;background:#fff;border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow)}.mobile-brand{display:flex;align-items:center;gap:12px;margin-bottom:42px}.mobile-brand .logo-box{width:64px;height:52px;border:1px solid var(--line);box-shadow:none}.mobile-brand .brand-name{color:var(--brand-dark);font-size:15px}.mobile-brand .brand-name small{color:#8b7d87}}
    @media(max-width:520px){body{background:#fff}.login-panel{display:block;padding:24px 20px 30px}.login-wrap{max-width:none;padding:0;border:0;border-radius:0;box-shadow:none}.mobile-brand{margin-bottom:48px}.login-wrap h2{font-size:34px}.sub{margin-bottom:28px}}
  </style>
</head>
<body>
  <main class="page">
    <section class="brand-panel" aria-label="Finance Alumni Association">
      <div class="brand-lockup"><span class="logo-box"><img src="/global_assets/images/logo.png" alt="FAA"></span><div class="brand-name">Finance Alumni Association<small>University of Dhaka</small></div></div>
      <div class="brand-copy"><p class="eyebrow">Event entry operations</p><h1>Every welcome starts here.</h1><p>Secure staff access for faster event verification, member identification and dependable entry management.</p></div>
      <div class="brand-foot"><span class="status-dot"></span> Authorized FAA event staff only</div>
    </section>
    <section class="login-panel">
      <div class="login-wrap">
        <div class="mobile-brand"><span class="logo-box"><img src="/global_assets/images/logo.png" alt="FAA"></span><div class="brand-name">Finance Alumni Association<small>University of Dhaka</small></div></div>
        <p class="eyebrow">Staff access</p><h2>Welcome back</h2><p class="sub">Sign in to verify event and member-card QR codes.</p>
        <% if (messages.error) { %><div class="alert" role="alert"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 17h.01"/></svg><span><%= messages.error %></span></div><% } %>
        <form method="post" action="/staff/login">
          <input type="hidden" name="returnTo" value="<%= returnTo %>">
          <div class="field"><label for="staff-email">Email address</label><div class="input-wrap"><svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m4 7 8 6 8-6"/></svg><input id="staff-email" type="email" name="email" required autocomplete="username" inputmode="email" placeholder="name@example.com"></div></div>
          <div class="field"><label for="staff-password">Password</label><div class="input-wrap"><svg class="input-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="5" y="10" width="14" height="11" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg><input id="staff-password" type="password" name="password" required autocomplete="current-password" placeholder="Enter your password"><button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false" onclick="togglePassword(this)"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"/><circle cx="12" cy="12" r="2.5"/></svg></button></div></div>
          <button class="submit-btn" type="submit">Sign in securely<svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
        </form>
        <p class="security-note"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>Your staff session is encrypted and protected</p>
      </div>
    </section>
  </main>
  <script>function togglePassword(button){var input=document.getElementById('staff-password');var showing=input.type==='text';input.type=showing?'password':'text';button.setAttribute('aria-label',showing?'Show password':'Hide password');button.setAttribute('aria-pressed',String(!showing))}</script>
</body>
</html>
