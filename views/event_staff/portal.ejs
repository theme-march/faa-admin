<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#792f6c">
  <title>FAA Staff Portal</title>
  <style>
    :root{--brand:#792f6c;--brand-dark:#4d1745;--brand-deep:#35102f;--brand-soft:#f6eef4;--ink:#271f25;--muted:#746a72;--line:#eadfe7;--surface:#fff;--success:#18754a;--success-bg:#ecf9f2;--danger:#a32836;--danger-bg:#fff1f2;--shadow:0 14px 38px rgba(69,27,61,.08)}
    *{box-sizing:border-box}html{scroll-behavior:smooth}[hidden]{display:none!important}body{margin:0;min-height:100vh;font-family:"Segoe UI",system-ui,-apple-system,BlinkMacSystemFont,sans-serif;color:var(--ink);background:radial-gradient(circle at 95% 4%,rgba(121,47,108,.07),transparent 24rem),#f8f5f7}body.scanner-open{overflow:hidden}button{font:inherit}.shell{width:min(1180px,calc(100% - 40px));margin:0 auto}
    .topbar{position:sticky;z-index:20;top:0;background:rgba(255,255,255,.94);border-bottom:1px solid rgba(121,47,108,.1);backdrop-filter:blur(14px)}.topbar-inner{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:24px}.brand{display:flex;align-items:center;gap:13px;min-width:0}.brand-logo{width:62px;height:47px;object-fit:contain}.brand-copy{min-width:0}.brand-title{display:block;color:var(--brand-dark);font-size:16px;font-weight:800;line-height:1.2}.brand-subtitle{display:block;margin-top:3px;color:#8a7d86;font-size:11px;font-weight:650;letter-spacing:.08em;text-transform:uppercase}
    .staff-nav{display:flex;align-items:center;gap:14px}.profile{display:flex;align-items:center;gap:10px}.avatar{width:40px;height:40px;display:grid;place-items:center;flex:0 0 auto;color:#fff;background:linear-gradient(145deg,var(--brand),var(--brand-dark));border-radius:50%;font-size:14px;font-weight:800;box-shadow:0 6px 14px rgba(121,47,108,.2)}.profile-copy{text-align:right}.profile-name{display:block;max-width:190px;overflow:hidden;color:#3a2d37;font-size:14px;font-weight:750;text-overflow:ellipsis;white-space:nowrap}.profile-role{display:block;margin-top:2px;color:#8b7f87;font-size:11px}.logout{min-height:42px;display:inline-flex;align-items:center;gap:7px;padding:9px 13px;color:var(--brand);border:1px solid #ddcfd9;border-radius:10px;font-size:13px;font-weight:750;text-decoration:none;transition:background .18s,border-color .18s}.logout:hover{background:var(--brand-soft);border-color:#cdb8c7}.logout:focus-visible{outline:3px solid rgba(121,47,108,.2);outline-offset:2px}
    .main{padding-top:28px;padding-bottom:54px}.hero{position:relative;isolation:isolate;overflow:hidden;display:grid;grid-template-columns:1fr auto;align-items:end;gap:30px;margin-bottom:24px;padding:clamp(28px,5vw,50px);color:#fff;background:linear-gradient(125deg,var(--brand-deep),var(--brand-dark) 52%,var(--brand));border-radius:24px;box-shadow:0 20px 45px rgba(70,25,61,.18)}.hero:after{content:"";position:absolute;z-index:-1;right:-85px;top:-170px;width:390px;height:390px;border:1px solid rgba(255,255,255,.13);border-radius:50%;box-shadow:0 0 0 65px rgba(255,255,255,.025),0 0 0 130px rgba(255,255,255,.02)}.hero-kicker{display:flex;align-items:center;gap:9px;margin:0 0 12px;color:rgba(255,255,255,.7);font-size:12px;font-weight:800;letter-spacing:.13em;text-transform:uppercase}.online-dot{width:8px;height:8px;border-radius:50%;background:#78dc9a;box-shadow:0 0 0 5px rgba(120,220,154,.13)}.hero h1{margin:0;font-size:clamp(32px,4.2vw,52px);line-height:1.07;letter-spacing:-.04em}.hero p{max-width:620px;margin:16px 0 0;color:rgba(255,255,255,.76);font-size:16px;line-height:1.6}.hero-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:24px}.scan-primary{min-height:50px;display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:12px 18px;color:var(--brand-dark);background:#fff;border:0;border-radius:12px;box-shadow:0 12px 24px rgba(26,5,22,.2);font-size:14px;font-weight:800;cursor:pointer;transition:transform .18s,box-shadow .18s}.scan-primary:hover{transform:translateY(-1px);box-shadow:0 15px 28px rgba(26,5,22,.25)}.scan-primary:focus-visible{outline:3px solid rgba(255,255,255,.42);outline-offset:3px}.hero-stats{display:flex;gap:10px}.stat{min-width:112px;padding:15px 17px;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.14);border-radius:15px;backdrop-filter:blur(6px)}.stat strong{display:block;font-size:24px;line-height:1}.stat span{display:block;margin-top:7px;color:rgba(255,255,255,.7);font-size:11px;text-transform:uppercase;letter-spacing:.07em}
    .scan-guide{display:flex;align-items:center;gap:16px;margin-bottom:24px;padding:17px 20px;background:#fff;border:1px solid var(--line);border-radius:16px;box-shadow:0 8px 24px rgba(69,27,61,.04)}.guide-icon{width:44px;height:44px;display:grid;place-items:center;flex:0 0 auto;color:var(--brand);background:var(--brand-soft);border-radius:12px}.guide-icon svg{width:23px;height:23px}.scan-guide-copy{min-width:0;flex:1}.scan-guide strong{display:block;margin-bottom:3px;font-size:14px}.scan-guide p{margin:0;color:var(--muted);font-size:13px;line-height:1.5}.scan-guide-btn{min-height:42px;display:inline-flex;align-items:center;gap:7px;padding:9px 14px;color:#fff;background:var(--brand);border:0;border-radius:10px;font-size:12px;font-weight:800;white-space:nowrap;cursor:pointer}.scan-guide-btn:hover{background:var(--brand-dark)}
    .content-grid{display:grid;grid-template-columns:minmax(0,1.22fr) minmax(330px,.78fr);align-items:start;gap:24px}.card{overflow:hidden;background:var(--surface);border:1px solid var(--line);border-radius:20px;box-shadow:var(--shadow)}.card-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:23px 24px 18px}.card-head h2{margin:0;font-size:21px;letter-spacing:-.02em}.count{display:inline-flex;align-items:center;justify-content:center;min-width:29px;height:29px;padding:0 9px;color:var(--brand);background:var(--brand-soft);border-radius:20px;font-size:12px;font-weight:800}.card-body{padding:0 24px 24px}
    .event-list{display:grid;gap:12px}.event{display:grid;grid-template-columns:48px minmax(0,1fr);gap:15px;padding:16px;background:#fcfafb;border:1px solid #efe6ec;border-radius:15px;transition:transform .18s,border-color .18s,box-shadow .18s}.event:hover{transform:translateY(-1px);border-color:#d9c5d3;box-shadow:0 8px 18px rgba(71,26,61,.06)}.date-tile{width:48px;height:52px;display:grid;place-items:center;align-content:center;color:var(--brand);background:#fff;border:1px solid #e3d4de;border-radius:11px}.date-tile strong{font-size:18px;line-height:1}.date-tile small{margin-top:3px;font-size:9px;font-weight:800;letter-spacing:.07em;text-transform:uppercase}.event-title{display:block;margin:0 0 7px;color:#32272f;font-size:15px;font-weight:800;line-height:1.35}.meta{display:flex;flex-wrap:wrap;gap:6px 14px;color:var(--muted);font-size:12px;line-height:1.45}.meta span{display:inline-flex;align-items:center;gap:6px}.meta svg{width:14px;height:14px;color:#9e7995}
    .alerts{display:grid;gap:10px;margin-bottom:14px}.alert{display:flex;align-items:flex-start;gap:9px;padding:12px 13px;border-radius:11px;font-size:13px;line-height:1.45}.alert.error{color:var(--danger);background:var(--danger-bg);border:1px solid #ffd7dc}.alert.success{color:var(--success);background:var(--success-bg);border:1px solid #ccebdc}.alert svg{flex:0 0 auto;margin-top:1px}
    .recent-list{display:grid}.recent{position:relative;padding:15px 0;border-top:1px solid #f0e8ed}.recent:first-child{border-top:0}.recent-top{display:flex;align-items:flex-start;justify-content:space-between;gap:10px}.participant{display:block;color:#342831;font-size:14px;font-weight:800;line-height:1.35}.recent-event{display:block;margin-top:3px;color:var(--muted);font-size:12px;line-height:1.4}.badge{display:inline-flex;align-items:center;padding:5px 8px;color:var(--success);background:var(--success-bg);border-radius:20px;font-size:9px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;white-space:nowrap}.recent-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:10px;color:#8d8189;font-size:11px}.reverse-btn{min-height:34px;padding:7px 10px;color:var(--danger);background:#fff;border:1px solid #efc8ce;border-radius:9px;font-size:11px;font-weight:750;cursor:pointer}.reverse-btn:hover{background:var(--danger-bg)}.reverse-btn:focus-visible{outline:3px solid rgba(163,40,54,.16)}
    .empty{display:grid;place-items:center;padding:32px 18px;text-align:center;background:#fcfafb;border:1px dashed #ddced8;border-radius:14px}.empty-icon{width:52px;height:52px;display:grid;place-items:center;margin-bottom:12px;color:#9b6f91;background:var(--brand-soft);border-radius:50%}.empty-icon svg{width:25px;height:25px}.empty strong{font-size:14px}.empty p{max-width:300px;margin:6px 0 0;color:var(--muted);font-size:12px;line-height:1.5}
    .scanner-modal{position:fixed;z-index:1000;inset:0;display:grid;place-items:center;padding:20px;background:rgba(22,10,20,.88);opacity:0;backdrop-filter:blur(10px);transition:opacity .18s}.scanner-modal.visible{opacity:1}.scanner-dialog{width:min(100%,540px);max-height:calc(100vh - 30px);overflow:auto;color:#fff;background:#160f17;border:1px solid rgba(255,255,255,.1);border-radius:24px;box-shadow:0 30px 90px rgba(0,0,0,.46);transform:translateY(12px) scale(.985);transition:transform .18s}.scanner-modal.visible .scanner-dialog{transform:none}.scanner-head{display:flex;align-items:flex-start;justify-content:space-between;gap:20px;padding:22px 22px 16px}.scanner-head h2{margin:0;font-size:22px;letter-spacing:-.02em}.scanner-head p{margin:5px 0 0;color:rgba(255,255,255,.6);font-size:12px;line-height:1.45}.scanner-close{width:42px;height:42px;display:grid;place-items:center;flex:0 0 auto;padding:0;color:#fff;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);border-radius:12px;cursor:pointer}.scanner-close:hover{background:rgba(255,255,255,.15)}
    .scanner-viewport{position:relative;overflow:hidden;aspect-ratio:1/1;margin:0 22px;background:#070607;border-radius:18px}.qr-reader{position:absolute;inset:0;width:100%;height:100%;overflow:hidden}.qr-reader video,.qr-reader canvas{width:100%!important;height:100%!important;object-fit:cover!important}.scan-shade{position:absolute;z-index:4;inset:0;pointer-events:none;background:linear-gradient(rgba(10,6,10,.34),rgba(10,6,10,.34))}.scan-frame{position:absolute;z-index:5;left:50%;top:50%;width:min(68%,310px);aspect-ratio:1;transform:translate(-50%,-50%);border-radius:18px;box-shadow:0 0 0 100vmax rgba(8,5,8,.5);pointer-events:none}.corner{position:absolute;width:46px;height:46px;border-color:#d56cc2;border-style:solid;filter:drop-shadow(0 0 7px rgba(213,108,194,.42))}.corner.tl{left:0;top:0;border-width:3px 0 0 3px;border-radius:17px 0 0}.corner.tr{right:0;top:0;border-width:3px 3px 0 0;border-radius:0 17px 0 0}.corner.bl{left:0;bottom:0;border-width:0 0 3px 3px;border-radius:0 0 0 17px}.corner.br{right:0;bottom:0;border-width:0 3px 3px 0;border-radius:0 0 17px}.scan-line{position:absolute;left:7px;right:7px;top:8px;height:2px;background:linear-gradient(90deg,transparent,#f292df 15%,#fff 50%,#f292df 85%,transparent);box-shadow:0 0 12px #d56cc2;animation:scanLine 2.2s ease-in-out infinite}.scan-complete .scan-line{animation:none;top:50%;background:#7ee4aa;box-shadow:0 0 18px #7ee4aa}@keyframes scanLine{0%,100%{top:8px;opacity:.65}50%{top:calc(100% - 10px);opacity:1}}
    .scanner-status{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;gap:9px;min-height:48px;margin:15px 22px 0;padding:10px 13px;color:rgba(255,255,255,.76);background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.08);border-radius:12px;font-size:13px;font-weight:650;text-align:center}.scanner-status:before{content:"";width:8px;height:8px;flex:0 0 auto;background:#b474a8;border-radius:50%;box-shadow:0 0 0 5px rgba(180,116,168,.11)}.scanner-status.scanning:before{background:#7ee4aa;animation:statusPulse 1.4s infinite}.scanner-status.loading:before{background:#f3ca72}.scanner-status.success{color:#a9f0c7;background:rgba(38,137,84,.14);border-color:rgba(126,228,170,.2)}.scanner-status.success:before{background:#7ee4aa}.scanner-status.verifying:after{content:"";position:absolute;left:0;bottom:0;width:100%;height:3px;background:linear-gradient(90deg,#7ee4aa,#d56cc2);transform-origin:left;animation:verifyProgress 2s linear forwards}.scanner-status.error{color:#ffb6c0;background:rgba(190,49,68,.14);border-color:rgba(255,139,155,.2)}.scanner-status.error:before{background:#ff8293}@keyframes statusPulse{50%{box-shadow:0 0 0 8px rgba(126,228,170,0)}}@keyframes verifyProgress{from{transform:scaleX(0)}to{transform:scaleX(1)}}
    .scanner-actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:15px 22px 22px}.scanner-action{min-height:46px;display:flex;align-items:center;justify-content:center;gap:8px;padding:10px 12px;color:#fff;background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.12);border-radius:11px;font-size:12px;font-weight:750;cursor:pointer}.scanner-action[hidden]+.scanner-action{grid-column:1/-1}.scanner-action:hover{background:rgba(255,255,255,.14)}.scanner-action:focus-visible,.scanner-close:focus-visible{outline:3px solid rgba(213,108,194,.45);outline-offset:2px}.scanner-note{margin:-7px 22px 21px;color:rgba(255,255,255,.43);font-size:10px;line-height:1.45;text-align:center}
    @media(max-width:900px){.content-grid{grid-template-columns:1fr}.hero{align-items:start}.hero-stats{flex-direction:column}.stat{min-width:128px}.recent-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 20px}.recent:nth-child(2){border-top:0}}
    @media(max-width:680px){.shell{width:min(100% - 28px,1180px)}.topbar-inner{min-height:68px}.brand-logo{width:52px;height:40px}.brand-title{font-size:14px}.brand-subtitle,.profile-copy{display:none}.staff-nav{gap:8px}.avatar{width:36px;height:36px}.logout{width:40px;height:40px;justify-content:center;padding:0}.logout span{display:none}.main{padding-top:18px}.hero{display:block;margin-bottom:16px;padding:28px 22px;border-radius:19px}.hero p{font-size:14px}.hero-stats{display:grid;grid-template-columns:1fr 1fr;margin-top:24px}.stat{min-width:0}.scan-guide{align-items:flex-start;margin-bottom:16px;padding:15px}.scan-guide-btn{display:none}.content-grid{gap:16px}.card{border-radius:17px}.card-head{padding:20px 18px 15px}.card-body{padding:0 18px 20px}.recent-list{grid-template-columns:1fr}.recent:nth-child(2){border-top:1px solid #f0e8ed}.scanner-modal{padding:0;background:#160f17}.scanner-dialog{width:100%;max-height:none;height:100%;border:0;border-radius:0;display:flex;flex-direction:column}.scanner-head{padding:18px 17px 14px}.scanner-viewport{width:100%;margin:0;border-radius:0;flex:0 0 auto}.scanner-status{margin:14px 16px 0}.scanner-actions{margin-top:auto;padding:14px 16px}.scanner-note{margin:-3px 17px 17px}}
    @media(max-width:420px){.shell{width:calc(100% - 20px)}.brand-title{font-size:13px}.brand-logo{width:46px}.hero{padding:25px 18px}.hero h1{font-size:31px}.hero-stats{gap:8px}.stat{padding:13px}.stat strong{font-size:20px}.scan-guide{gap:12px}.guide-icon{width:40px;height:40px}.event{grid-template-columns:42px minmax(0,1fr);padding:13px;gap:12px}.date-tile{width:42px;height:48px}.card-head h2{font-size:19px}}
  </style>
</head>
<body>
  <%
    var assignedEvents = events || [];
    var recentCheckins = recent || [];
    var initials = String(staff.name || 'FAA').split(/\s+/).filter(Boolean).slice(0, 2).map(function(part){ return part.charAt(0); }).join('').toUpperCase();
    function asDate(value) { var d = value ? new Date(value) : null; return d && !isNaN(d.getTime()) ? d : null; }
    function formatDay(value) { var d = asDate(value); return d ? d.toLocaleDateString('en-GB',{day:'2-digit',timeZone:'Asia/Dhaka'}) : '--'; }
    function formatMonth(value) { var d = asDate(value); return d ? d.toLocaleDateString('en-GB',{month:'short',timeZone:'Asia/Dhaka'}) : 'TBA'; }
    function formatEventDate(value) { var d = asDate(value); return d ? d.toLocaleDateString('en-GB',{weekday:'short',day:'2-digit',month:'short',year:'numeric',timeZone:'Asia/Dhaka'}) : 'Date to be announced'; }
    function formatTime(value) { var d = asDate(value); return d ? d.toLocaleTimeString('en-US',{hour:'numeric',minute:'2-digit',timeZone:'Asia/Dhaka'}) : ''; }
    function formatCheckin(value) { var d = asDate(value); return d ? d.toLocaleString('en-GB',{day:'2-digit',month:'short',hour:'numeric',minute:'2-digit',timeZone:'Asia/Dhaka'}) : (value || '-'); }
  %>
  <header class="topbar">
    <div class="shell topbar-inner">
      <div class="brand"><img class="brand-logo" src="/global_assets/images/logo.png" alt="FAA"><div class="brand-copy"><span class="brand-title">FAA Staff Portal</span><span class="brand-subtitle">Finance Alumni Association</span></div></div>
      <nav class="staff-nav" aria-label="Staff account">
        <div class="profile"><span class="avatar" aria-hidden="true"><%= initials %></span><div class="profile-copy"><span class="profile-name"><%= staff.name %></span><span class="profile-role"><%= staff.role === 'event_manager' ? 'Event Manager' : 'Entry Staff' %></span></div></div>
        <a class="logout" href="/staff/logout" aria-label="Logout"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 17l5-5-5-5M15 12H3M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/></svg><span>Logout</span></a>
      </nav>
    </div>
  </header>

  <main class="shell main">
    <section class="hero">
      <div><p class="hero-kicker"><span class="online-dot"></span>Staff session active</p><h1>Ready to welcome<br>our members.</h1><p>Use this device's camera to scan an Event QR or Member Card QR. Your signed-in staff account will be recognized automatically.</p><div class="hero-actions"><button class="scan-primary" type="button" data-open-qr-scanner><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8V5a2 2 0 0 1 2-2h3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M8 21H5a2 2 0 0 1-2-2v-3"/><path d="M8 8h3v3H8zM14 8h2v2h-2zM8 14h2v2H8zM13 13h3v3h-3z"/></svg>Open QR Scanner</button></div></div>
      <div class="hero-stats" aria-label="Portal summary"><div class="stat"><strong><%= assignedEvents.length %></strong><span>Assigned events</span></div><div class="stat"><strong><%= recentCheckins.length %></strong><span>Recent entries</span></div></div>
    </section>

    <section class="scan-guide" aria-label="Scanning instruction"><span class="guide-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8V5a2 2 0 0 1 2-2h3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M8 21H5a2 2 0 0 1-2-2v-3"/><path d="M8 8h3v3H8zM14 8h2v2h-2zM8 14h2v2H8zM13 13h3v3h-3z"/></svg></span><div class="scan-guide-copy"><strong>Camera scanner is ready</strong><p>Keep this browser session signed in. Review participant details before confirming entry.</p></div><button class="scan-guide-btn" type="button" data-open-qr-scanner><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 8V5a2 2 0 0 1 2-2h3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M8 21H5a2 2 0 0 1-2-2v-3"/></svg>Start scanner</button></section>

    <div class="content-grid">
      <section class="card">
        <div class="card-head"><h2>Assigned events</h2><span class="count"><%= assignedEvents.length %></span></div>
        <div class="card-body">
          <% if (!assignedEvents.length) { %><div class="empty"><span class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M16 3v4M8 3v4M3 10h18"/></svg></span><strong>No events assigned yet</strong><p>Assigned events will appear here when an administrator adds this staff account.</p></div><% } %>
          <% if (assignedEvents.length) { %><div class="event-list"><% assignedEvents.forEach(function(e){ %><article class="event"><div class="date-tile"><strong><%= formatDay(e.event_date) %></strong><small><%= formatMonth(e.event_date) %></small></div><div><strong class="event-title"><%= e.event_title %></strong><div class="meta"><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg><%= formatEventDate(e.event_date) %><% if (formatTime(e.event_date)) { %> · <%= formatTime(e.event_date) %><% } %></span><span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg><%= e.event_venue || 'Venue to be announced' %></span></div></div></article><% }) %></div><% } %>
        </div>
      </section>

      <section class="card">
        <div class="card-head"><h2>Recent check-ins</h2><span class="count"><%= recentCheckins.length %></span></div>
        <div class="card-body">
          <% if (messages.error || messages.success) { %><div class="alerts"><% if (messages.error) { %><div class="alert error" role="alert"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v6M12 17h.01"/></svg><span><%= messages.error %></span></div><% } %><% if (messages.success) { %><div class="alert success" role="status"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="m8 12 2.5 2.5L16 9"/></svg><span><%= messages.success %></span></div><% } %></div><% } %>
          <% if (!recentCheckins.length) { %><div class="empty"><span class="empty-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 8V5a2 2 0 0 1 2-2h3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M8 21H5a2 2 0 0 1-2-2v-3"/><path d="m8 12 2.5 2.5L16 9"/></svg></span><strong>No check-ins yet</strong><p>Your latest successful event entries will be shown here.</p></div><% } %>
          <% if (recentCheckins.length) { %><div class="recent-list"><% recentCheckins.forEach(function(r){ %><article class="recent"><div class="recent-top"><div><strong class="participant"><%= r.full_name || 'Participant' %></strong><span class="recent-event"><%= r.event_title || '-' %></span></div><span class="badge"><%= r.qr_type %></span></div><div class="recent-meta"><span><%= formatCheckin(r.checked_in_at) %></span><% if (staff.role === 'event_manager') { %><form method="post" action="/staff/checkin/<%= r.id %>/reverse" onsubmit="return confirm('Reverse this check-in?')"><input type="hidden" name="reason" value="Corrected by Event Manager"><button class="reverse-btn" type="submit">Reverse entry</button></form><% } %></div></article><% }) %></div><% } %>
        </div>
      </section>
    </div>
  </main>

  <div class="scanner-modal" id="qr-scanner-modal" role="dialog" aria-modal="true" aria-labelledby="qr-scanner-title" hidden>
    <section class="scanner-dialog">
      <header class="scanner-head"><div><h2 id="qr-scanner-title">Scan FAA QR Code</h2><p>Place the full QR code inside the frame</p></div><button class="scanner-close" id="close-qr-scanner" type="button" aria-label="Close scanner"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg></button></header>
      <div class="scanner-viewport">
        <div class="qr-reader" id="qr-reader"></div>
        <div class="scan-shade"></div>
        <div class="scan-frame" aria-hidden="true"><span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span><span class="scan-line"></span></div>
      </div>
      <div class="scanner-status loading" id="qr-scanner-status" role="status" aria-live="polite"><span id="qr-scanner-status-text">Starting camera…</span></div>
      <div class="scanner-actions">
        <button class="scanner-action" id="switch-qr-camera" type="button" hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m20 7-3-3v2H7a4 4 0 0 0-4 4M4 17l3 3v-2h10a4 4 0 0 0 4-4"/></svg>Switch camera</button>
        <button class="scanner-action" id="upload-qr-button" type="button"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M4 15v4a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-4"/></svg>Upload QR image</button>
        <input id="qr-image-input" type="file" accept="image/*" hidden>
      </div>
      <p class="scanner-note">Only authorized FAA Event and Member Card QR codes are accepted.</p>
    </section>
  </div>
  <script src="/javascripts/html5-qrcode.min.js?v=2.3.8"></script>
  <script src="/javascripts/staff-qr-scanner.js?v=20260826-2"></script>
</body>
</html>
