<div class="page-header page-header-light"><div class="breadcrumb-line breadcrumb-line-light"><div class="breadcrumb"><a href="/event-staff" class="breadcrumb-item">Event Staff</a><span class="breadcrumb-item active"><%= staff ? 'Edit' : 'Add' %></span></div></div></div>
<div class="content"><div class="card"><div class="card-header"><h5 class="card-title"><%= staff ? 'Edit Staff Account' : 'Create Staff Account' %></h5></div><div class="card-body">
  <% if (messages.error) { %><div class="alert alert-danger"><%= messages.error %></div><% } %>
  <form method="post" action="<%= staff ? '/event-staff/' + staff.id + '/edit' : '/event-staff/add' %>">
    <div class="row"><div class="form-group col-md-6"><label>Name</label><input name="name" class="form-control" required value="<%= staff?.name || '' %>"></div>
    <div class="form-group col-md-6"><label>Email</label><input type="email" name="email" class="form-control" required value="<%= staff?.email || '' %>"></div></div>
    <div class="row"><div class="form-group col-md-6"><label>Password <%= staff ? '(leave blank to keep current password)' : '' %></label><input type="password" name="password" class="form-control" minlength="8" <%= staff ? '' : 'required' %> autocomplete="new-password"><small class="text-muted">Minimum 8 characters.</small></div>
    <div class="form-group col-md-6"><label>Role</label><select name="role" class="form-control"><option value="entry_staff" <%= staff?.role !== 'event_manager' ? 'selected' : '' %>>Entry Staff</option><option value="event_manager" <%= staff?.role === 'event_manager' ? 'selected' : '' %>>Event Manager</option></select></div></div>
    <div class="form-group"><label>Assigned events</label><select name="event_ids" class="form-control" multiple size="10">
      <% (events || []).forEach(function(event){ %><option value="<%= event.id %>" <%= assignedEventIds.includes(String(event.id)) ? 'selected' : '' %>><%= event.event_title %> — <%= event.event_date ? new Date(event.event_date).toLocaleDateString('en-GB') : 'No date' %></option><% }) %>
    </select><small class="text-muted">Use Ctrl/Cmd to select multiple events. Staff can only check in assigned events.</small></div>
    <button class="btn btn-primary"><%= staff ? 'Update Staff' : 'Create Staff' %></button><a href="/event-staff" class="btn btn-link">Cancel</a>
  </form>
</div></div></div>
