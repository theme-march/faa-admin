# Server Environment (development | production)
NODE_ENV=development
PORT=3000

# Base URLs
# Frontend URL: in local dev use http://localhost:3001, on live server use https://faa-dubd.org
FRONTEND_BASE_URL=http://localhost:3001
# Backend URL: in local dev use http://localhost:3000, on live server use https://cms.faa-dubd.org
BACKEND_BASE_URL=http://localhost:3000

# Member Card QR Base URL
MEMBER_CARD_QR_BASE_URL=http://localhost:3001/member/verify/

# Auth & Session Secrets
MEMBER_ACCESS_TOKEN_SECRET=1234567890abcdef1234567890abcdef
MEMBER_REFRESH_TOKEN_SECRET=1234567890abcdef1234567890abcdef
MEMBER_PASSWORD_RESET_SECRET=1234567890abcdef1234567890abcdef
BCRYPT_ROUNDS=10
SESSION_SECRET=replace-with-a-long-random-secret
